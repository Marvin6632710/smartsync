# =============================================================================
# SmartSync environment configuration
# =============================================================================
#
# LOCAL DEVELOPMENT — no Firebase account needed
# ---------------------------------------------
# Copy this file to .env.local. The app will talk to the local Firebase
# Emulator Suite instead of a real Firebase project. Maps use Google's
# external service and need the configuration at the bottom of this file;
# see GOOGLE_MAPS_SETUP.md. Other screens can run without map configuration.
#
#   npm run emulators     (in one terminal)
#   npm run seed          (once, to load demo data)
#   npm run dev           (in another terminal)
#
VITE_USE_EMULATORS=true

# =============================================================================
# REAL FIREBASE PROJECT
# ---------------------
# Set VITE_USE_EMULATORS=false and fill these in from:
#   Firebase console -> Project settings -> Your apps -> SDK setup and config
#
# These values are NOT secrets. A Firebase web API key identifies the project,
# it does not authorise anything on its own — access is controlled entirely by
# the rules in firestore.rules. They are still kept out of git because they
# differ per environment.
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Browser push (optional). The public half of the Web Push key pair from
# Firebase console -> Project settings -> Cloud Messaging -> Web Push
# certificates. Without it the app works as before and simply offers no
# browser notifications. Under the emulators it is not needed.
VITE_FCM_VAPID_KEY=

# Google Maps: required for maps, including when using the Firebase emulators.
# Enable Maps JavaScript API in a billing-enabled Google Cloud project. Create
# a browser key restricted to Maps JavaScript API and your site's referrers.
# Create a JavaScript map ID (raster) for Advanced Markers. These are browser
# configuration values, not server credentials. Keep actual values out of git.
# Put production values in .env.production and development values in .env.local.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
