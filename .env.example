# =============================================================================
# SmartSync environment configuration
# =============================================================================
#
# LOCAL DEVELOPMENT — no Firebase account needed
# ---------------------------------------------
# Copy this file to .env.local and leave it exactly as it is below. The app
# will talk to the local Firebase Emulator Suite instead of a real project:
#
#   npm run emulators     (in one terminal)
#   npm run seed          (once, to load demo data)
#   npm run dev           (in another terminal)
#
VITE_USE_EMULATORS=true

# =============================================================================
# REAL FIREBASE PROJECT
# ---------------------
# Set VITE_USE_EMULATORS=false and fill these in from:
#   Firebase console -> Project settings -> Your apps -> SDK setup and config
#
# These values are NOT secrets. A Firebase web API key identifies the project,
# it does not authorise anything on its own — access is controlled entirely by
# the rules in firestore.rules. They are still kept out of git because they
# differ per environment.
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
