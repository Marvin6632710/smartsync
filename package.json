{
  "name": "smartsync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "lint": "eslint src/",
    "emulators": "firebase emulators:start --project demo-smartsync",
    "seed": "node scripts/seed.js",
    "test": "npm run test:unit && npm run test:rules",
    "test:watch": "vitest",
    "deploy": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --project demo-smartsync --only firestore \"vitest run tests/rules\"",
    "evaluate": "node scripts/evaluate.mjs",
    "seed:production": "node scripts/seed-production.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  }
}
