rules_version = '2';

// =============================================================================
// SmartSync security rules
//
// Design principle: the client is untrusted. Every constraint the UI relies on
// (you can only join once, a full activity cannot be joined, only the host can
// edit, chat is for participants only) is enforced here too, because anyone
// can call Firestore directly without going through the UI.
//
// Privacy model: users/{uid} is the PUBLIC profile, readable by any signed-in
// user, because discovery and compatibility matching genuinely need it.
// Anything that must not be public — email, real name while anonymous mode is
// on, precise location — lives in users/{uid}/private/profile, readable only
// by its owner. Firestore has no field-level read rules, so separating the
// documents is the only way to make this real rather than cosmetic.
//
// Membership model: participants are a `participantUids` array on the activity
// document itself, NOT a subcollection. This is a correctness requirement, not
// a preference. Rules evaluate each write on its own against pre-write state
// and cannot see sibling writes in the same batch, so a design that kept the
// roster and a counter in two documents could not distinguish "incrementing
// because I joined" from "incrementing because I felt like it" — anyone could
// inflate an activity to full and lock others out. Holding the roster in one
// field makes each membership change atomically verifiable here.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function touches(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Has `ownerId` blocked `otherId`? Their block list is private, but rules
    // read through that — which is the point: blocking has to be enforceable
    // by the server without publishing who blocked whom.
    function hasBlocked(ownerId, otherId) {
      return exists(/databases/$(database)/documents/users/$(ownerId)/blocked/$(otherId));
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isTagList(value, maxItems) {
      return value is list && value.size() <= maxItems;
    }

    // ------------------------------------------------------------------ users

    function validPublicProfile(data) {
      return isString(data.name, 60)
        && isString(data.username, 40)
        && data.bio is string && data.bio.size() <= 300
        && isTagList(data.interests, 20)
        && isTagList(data.historyCategories, 40)
        && data.preferredTime is string
        && data.anonymous is bool
        && data.notificationsEnabled is bool
        && data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // Public profile: readable by any signed-in user. This is what powers
      // peer discovery, participant lists and compatibility scoring.
      allow read: if signedIn();

      allow create: if isSelf(uid) && validPublicProfile(request.resource.data);

      allow update: if isSelf(uid)
        && validPublicProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isSelf(uid);

      // Private half of the profile. Never readable by anyone else.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        // Anyone signed in may notify a user ("Bob joined your activity" has
        // to be written by Bob), but only with a well-formed unread message,
        // so a sender cannot forge a pre-read system notification.
        //
        // The recipient's own preference is enforced here rather than left to
        // the sending client. That is the whole reason `notificationsEnabled`
        // sits on the public profile: a setting only its owner can read is a
        // setting nobody else can honour.
        allow create: if signedIn()
          && isString(request.resource.data.title, 120)
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 300
          && request.resource.data.read == false
          && get(/databases/$(database)/documents/users/$(uid))
               .data.notificationsEnabled == true;
        allow update: if isSelf(uid) && touches(['read']);
        allow delete: if isSelf(uid);
      }

      match /following/{targetId} {
        allow read, write: if isSelf(uid);
      }

      // Who this user has blocked. Private to them: publishing it would tell
      // people they had been blocked, and by whom, which is its own kind of
      // harm. The rules above read it with exists(), which sees past read
      // permissions, so it is enforced without ever being exposed.
      match /blocked/{targetId} {
        allow read: if isSelf(uid);
        // You may only block somebody else, and never yourself — a self block
        // would quietly make your own activities invisible to you.
        allow create: if isSelf(uid)
          && targetId != uid
          && isString(request.resource.data.name, 60);
        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    // ------------------------------------------------------------- activities

    // The category vocabulary, mirrored from src/data/categories.js. Kept in
    // both places deliberately: the client copy drives the UI, and this copy
    // stops anything else being written at all. An arbitrary category string
    // reached a Leaflet marker's innerHTML, which made it an injection point,
    // so this is a security control and not merely tidiness.
    function isKnownCategory(value) {
      return value in [
        'Football', 'Basketball', 'Running', 'Gym', 'Study', 'Coffee',
        'Gaming', 'Hangouts', 'Cycling', 'Movies', 'Food', 'Events'
      ];
    }

    function validActivity(data) {
      return isString(data.title, 100)
        && data.description is string && data.description.size() <= 1000
        && isKnownCategory(data.category)
        && isString(data.locationName, 120)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.capacity is int && data.capacity >= 2 && data.capacity <= 500
        // Every query for activities filters on startsAt, so a document
        // without one is invisible to the app but still occupies the
        // collection. An integrity sweep found exactly that, written through
        // the REST API while the rules were not looking for it.
        && data.startsAt is timestamp
        && data.timeBand is string
        && isTagList(data.tags, 10)
        && data.status in ['active', 'cancelled']
        && data.participantUids is list
        && data.participantUids.size() <= data.capacity
        // A roster with the same uid twice would let one person consume every
        // seat, so duplicates are rejected outright.
        && data.participantUids.size() == data.participantUids.toSet().size();
    }

    function joinersAdded() {
      return request.resource.data.participantUids.toSet()
        .difference(resource.data.participantUids.toSet());
    }

    function joinersRemoved() {
      return resource.data.participantUids.toSet()
        .difference(request.resource.data.participantUids.toSet());
    }

    function rosterIsClean() {
      return request.resource.data.participantUids is list
        && request.resource.data.participantUids.size()
           == request.resource.data.participantUids.toSet().size();
    }

    // Exactly one person added, and it is the caller, and there is room.
    function joinsSelf() {
      return joinersAdded().hasOnly([request.auth.uid])
        && joinersAdded().size() == 1
        && joinersRemoved().size() == 0
        && request.resource.data.participantUids.size() <= resource.data.capacity
        && resource.data.status == 'active'
        // A host who blocked you does not have to host you. Enforced here
        // rather than by hiding the activity, because hiding is a client-side
        // courtesy and this is the part that has to actually hold.
        && !hasBlocked(resource.data.hostId, request.auth.uid);
    }

    // Exactly one person removed, and it is the caller. The host may not
    // leave their own activity — that would orphan it; they delete instead.
    function leavesSelf() {
      return joinersRemoved().hasOnly([request.auth.uid])
        && joinersRemoved().size() == 1
        && joinersAdded().size() == 0
        && request.auth.uid != resource.data.hostId;
    }

    // A host may remove any participant except themselves.
    function hostRemovesParticipant() {
      return resource.data.hostId == request.auth.uid
        && joinersAdded().size() == 0
        && joinersRemoved().size() == 1
        && !joinersRemoved().hasAny([resource.data.hostId]);
    }

    match /activities/{activityId} {
      // Discovery requires reading activities you have not joined.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        // A host starts as the sole participant of their own activity.
        && request.resource.data.participantUids == [request.auth.uid]
        && validActivity(request.resource.data);

      // Two disjoint kinds of update:
      //
      // 1. The host editing their own activity. May not touch the roster
      //    (membership is earned by joining, not granted by the host), may not
      //    hand the activity to someone else, and may not shrink capacity
      //    below the people already in.
      // 2. Anyone joining or leaving, or a host removing a participant. Only
      //    the roster and updatedAt may move, and the delta must be exactly
      //    the caller — which is checkable here precisely because it is a
      //    single field on a single document.
      allow update: if signedIn() && (
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.participantUids == resource.data.participantUids
          && request.resource.data.capacity >= resource.data.participantUids.size()
          && validActivity(request.resource.data)
        ) || (
          touches(['participantUids', 'updatedAt'])
          && rosterIsClean()
          && (joinsSelf() || leavesSelf() || hostRemovesParticipant())
        )
      );

      // A host may delete an activity that never got going — one where they
      // are still the only person on the roster. There is nobody whose plans
      // it would erase and, in practice, no conversation to strand.
      //
      // Anything anyone else has joined must be cancelled instead. Deleting
      // it would leave the messages subcollection unreachable (deleting a
      // document does not delete what lives beneath it) and would take other
      // people's chat history with it. See ADR-004.
      //
      // Residual risk, stated rather than hidden: a host who posted messages
      // to their own empty activity and then deleted it orphans those
      // messages. That is a negligible amount of data and only ever their
      // own words.
      allow delete: if signedIn()
        && resource.data.hostId == request.auth.uid
        && resource.data.participantUids == [request.auth.uid];

      // ----------------------------------------------------------- messages

      match /messages/{messageId} {
        function activity() {
          return get(/databases/$(database)/documents/activities/$(activityId)).data;
        }

        function isParticipant() {
          return signedIn() && request.auth.uid in activity().participantUids;
        }

        // Activity chat is tied to the activity, and does not outlive it by
        // much: thirty days after it starts, the thread stops being readable
        // and writable by anybody.
        //
        // This is retention enforced by the database, not a filter in the
        // client — a distinction that matters, because a client-side filter
        // is decoration that anyone can step around by querying directly.
        //
        // It is expiry of *access*, not deletion. Actually removing the
        // documents needs a scheduled job, and scheduled jobs on Firebase
        // mean Cloud Functions, which mean the paid plan. Saying "the chat
        // is deleted" would therefore be a lie; saying "nobody can reach it
        // any more, and here is the rule that stops them" is true and
        // checkable. Two tests cover it.
        function withinRetention() {
          return activity().startsAt > request.time - duration.value(30, 'd');
        }

        allow read: if isParticipant() && withinRetention();

        allow create: if isParticipant()
          && withinRetention()
          && request.resource.data.senderId == request.auth.uid
          && isString(request.resource.data.text, 2000);

        // Append-only: no silent edits, no deleting evidence.
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------- reports
    //
    // Write-only from the app's point of view. A reporter may file one and
    // read back their own; nobody can read anyone else's, edit one, or delete
    // one. Reports are evidence, and evidence that the accused can alter or
    // erase is not evidence.
    //
    // There is no in-app moderator queue: reports are reviewed in the Firebase
    // console. That is a real limitation and it is written down rather than
    // implied — see the README.
    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['user', 'activity', 'message']
        && isString(request.resource.data.targetId, 200)
        && request.resource.data.reason in
             ['harassment', 'inappropriate', 'spam', 'fake', 'safety', 'other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1000
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
