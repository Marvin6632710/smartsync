rules_version = '2';

// =============================================================================
// SmartSync security rules
//
// Design principle: the client is untrusted. Every constraint the UI relies on
// (you can only join once, a full activity cannot be joined, only the host can
// edit, chat is for participants only) is enforced here too, because anyone
// can call Firestore directly without going through the UI.
//
// Privacy model: users/{uid} is the PUBLIC profile, readable by any signed-in
// user, because discovery and compatibility matching genuinely need it.
// Anything that must not be public — email, real name while anonymous mode is
// on, precise location — lives in users/{uid}/private/profile, readable only
// by its owner. Firestore has no field-level read rules, so separating the
// documents is the only way to make this real rather than cosmetic.
//
// Membership model: participants are a `participantUids` array on the activity
// document itself, NOT a subcollection. This is a correctness requirement, not
// a preference. Rules evaluate each write on its own against pre-write state
// and cannot see sibling writes in the same batch, so a design that kept the
// roster and a counter in two documents could not distinguish "incrementing
// because I joined" from "incrementing because I felt like it" — anyone could
// inflate an activity to full and lock others out. Holding the roster in one
// field makes each membership change atomically verifiable here.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function touches(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ------------------------------------------------------------------ roles
    //
    // Roles live in their own collection, never on the profile a user can
    // edit. That is the whole design: a role stored anywhere its holder can
    // write is a role its holder can grant themselves.
    //
    // Two ranks and no more: an ordinary user, and an admin. `admin` can
    // only ever be set from the Firebase console. There is no in-app path
    // to create one, so compromising an admin cannot mint more admins, and
    // there is no lesser rank to hand out — the app writes `role: 'user'`
    // and nothing else. (A `moderator` rank existed once; a row still
    // saying so grants nothing and is treated as an ordinary user.)

    function roleDoc(uid) {
      return get(/databases/$(database)/documents/roles/$(uid)).data;
    }

    function hasRoleDoc() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() && hasRoleDoc() ? roleDoc(request.auth.uid).role : 'user';
    }

    // A suspended account holds its rank but exercises none of it. Otherwise
    // suspending an admin who was abusing the queue would take nothing away
    // from them: they would keep removing activities and suspending people
    // while suspended themselves. The rank is kept rather than stripped so
    // that lifting the suspension restores what they were, and so the record
    // shows a suspended admin rather than a demoted stranger.
    function isAdmin() {
      return myRole() == 'admin' && !cannotAct();
    }

    // The rank of the person being acted ON, as opposed to myRole(), which is
    // the rank of whoever is calling. Somebody with no row is an ordinary user.
    function rankOf(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        ? roleDoc(uid).role : 'user';
    }

    // Suspension is a state, not a role: it can sit on anybody. A suspended
    // account can still read — being told why you cannot post is the point —
    // but cannot create, join, or say anything.
    //
    // Written to take a uid rather than always meaning "me", because the
    // sharpest question suspension raises is about somebody else: is the host
    // of the activity I am about to join suspended?
    function accountSuspended(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        && get(/databases/$(database)/documents/roles/$(uid)).data.suspended == true;
    }

    // A closed account. Strictly more than a suspension: a suspended person
    // can still read SmartSync and is told why, because the point is that
    // they can see the limit and appeal it. A closed account is the end of
    // the relationship — nothing is readable and nothing is writable.
    //
    // `get(...).data.get('banned', false)` rather than `.banned`, because
    // every role row written before this existed has only two fields and
    // reading a missing key would error the rule into refusing everybody.
    function accountBanned(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        && get(/databases/$(database)/documents/roles/$(uid)).data.get('banned', false) == true;
    }

    function isSuspended() {
      return signedIn() && accountSuspended(request.auth.uid);
    }

    function isBanned() {
      return signedIn() && accountBanned(request.auth.uid);
    }

    // Everything a suspension refuses, a closed account refuses too. Written
    // as one helper so a new write path cannot accidentally check only one of
    // the two — which is exactly the kind of gap that hides in a system with
    // more than one kind of restriction.
    function cannotAct() {
      return isSuspended() || isBanned();
    }

    // Has `ownerId` blocked `otherId`? Their block list is private, but rules
    // read through that — which is the point: blocking has to be enforceable
    // by the server without publishing who blocked whom.
    function hasBlocked(ownerId, otherId) {
      return exists(/databases/$(database)/documents/users/$(ownerId)/blocked/$(otherId));
    }

    // Is this report about the caller?
    //
    // `subjectId` is the person answerable for whatever was reported — the
    // person themselves, the host of the activity, or the sender of the
    // message. It is verified against reality when the report is created (see
    // namesTheRightPerson), so it can be trusted here and by the queue, which
    // suspends `subjectId` and not `targetId`. Reporting a message used to
    // suspend the message: `targetId` is a message id, and a roles document
    // was being written against it.
    //
    // The two fallbacks keep reports filed before `subjectId` existed
    // reviewable, rather than freezing them into the queue forever.
    function aboutMe(report) {
      return ('subjectId' in report && report.subjectId == request.auth.uid)
        || report.targetId == request.auth.uid
        || (
          report.targetType == 'activity'
          && exists(/databases/$(database)/documents/activities/$(report.targetId))
          && get(/databases/$(database)/documents/activities/$(report.targetId))
               .data.hostId == request.auth.uid
        );
    }

    // Does the report point at the person actually responsible for the thing
    // being reported? Checked at creation, because `subjectId` decides who
    // gets suspended: without this a reporter could quote one person's
    // message and name somebody else as its sender.
    function namesTheRightPerson(r) {
      return (r.targetType == 'user' && r.subjectId == r.targetId)
        || (
          r.targetType == 'activity'
          && exists(/databases/$(database)/documents/activities/$(r.targetId))
          && get(/databases/$(database)/documents/activities/$(r.targetId)).data.hostId
               == r.subjectId
        )
        || (
          r.targetType == 'message'
          && exists(/databases/$(database)/documents/activities/$(r.activityId)/messages/$(r.targetId))
          && get(/databases/$(database)/documents/activities/$(r.activityId)/messages/$(r.targetId))
               .data.senderId == r.subjectId
        );
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isTagList(value, maxItems) {
      return value is list && value.size() <= maxItems;
    }

    function validPictureVersion(data) {
      return !('pictureVersion' in data)
        || (data.pictureVersion is string
          && data.pictureVersion.matches('^[a-zA-Z0-9-]{1,64}$'));
    }

    // Resized, metadata-free pictures live outside the activity and people
    // feeds. Each parent has just a version, and the fixed document id binds
    // the picture to its owner. Both records are saved in the same batch.
    function validPicture(data) {
      return data.keys().hasOnly(['dataUrl', 'version', 'updatedAt'])
        && data.version is string && data.version.matches('^[a-zA-Z0-9-]{1,64}$')
        && data.dataUrl is string && data.dataUrl.size() <= 320000
        && data.dataUrl.matches('^data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/]+=*$')
        && data.updatedAt == request.time;
    }

    match /profilePictures/{uid} {
      // Even with the path and version known, an anonymous person's photo
      // cannot be fetched by another user. Only its owner can preview it.
      allow get: if signedIn()
        && (isSelf(uid) || (!isBanned()
          && get(/databases/$(database)/documents/users/$(uid)).data.anonymous == false));
      allow create, update: if isSelf(uid) && !isBanned()
        && validPicture(request.resource.data)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.pictureVersion
          == request.resource.data.version;
      allow delete: if isSelf(uid) && !isBanned();
    }

    match /activityPictures/{activityId} {
      allow get: if signedIn() && !isBanned()
        && exists(/databases/$(database)/documents/activities/$(activityId));
      allow create, update: if signedIn() && !isBanned()
        && validPicture(request.resource.data)
        && getAfter(/databases/$(database)/documents/activities/$(activityId)).data.hostId
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/activities/$(activityId)).data.status != 'removed'
        && getAfter(/databases/$(database)/documents/activities/$(activityId)).data.pictureVersion
          == request.resource.data.version;
      // Read the original parent: this also works when both are deleted in
      // one batch. A non-host and a removed activity's host cannot erase it.
      allow delete: if signedIn() && !isBanned()
        && get(/databases/$(database)/documents/activities/$(activityId)).data.hostId
          == request.auth.uid
        && get(/databases/$(database)/documents/activities/$(activityId)).data.status != 'removed';
    }

    // ------------------------------------------------------------------ users

    function validPublicProfile(data) {
      return isString(data.name, 60)
        && validPictureVersion(data)
        && isString(data.username, 40)
        && data.bio is string && data.bio.size() <= 300
        && isTagList(data.interests, 20)
        && isTagList(data.historyCategories, 40)
        && data.preferredTime is string
        && data.anonymous is bool
        && data.notificationsEnabled is bool
        && data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // Public profile: readable by any signed-in user. This is what powers
      // peer discovery, participant lists and compatibility scoring.
      //
      // A closed account keeps only itself. It has to be able to load its own
      // profile or the app cannot boot far enough to tell it what happened —
      // a blank error screen is not an explanation.
      allow read: if signedIn() && (isSelf(uid) || !isBanned());

      // A closed account cannot rewrite the profile other people see. It is
      // the one write left that changes how somebody is recognised, and the
      // point of closing an account is that the relationship has ended.
      //
      // A *suspended* account keeps all of this on purpose. They are still a
      // member with a limit on them, and anonymous mode is a protection —
      // taking someone's privacy controls away as a punishment is a
      // punishment in the wrong direction.
      allow create: if isSelf(uid) && !isBanned() && validPublicProfile(request.resource.data);

      allow update: if isSelf(uid)
        && !isBanned()
        && validPublicProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isSelf(uid) && !isBanned();

      // Private half of the profile. Never readable by anyone else.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        // Anyone signed in may notify a user ("Bob joined your activity" has
        // to be written by Bob), but only with a well-formed unread message,
        // so a sender cannot forge a pre-read system notification.
        //
        // The recipient's own preference is enforced here rather than left to
        // the sending client. That is the whole reason `notificationsEnabled`
        // sits on the public profile: a setting only its owner can read is a
        // setting nobody else can honour.
        //
        // Two limits that are easy to miss, because notifications are the one
        // collection anybody may write to. That makes them the way around
        // every other rule: no activity, no message, just a direct write into
        // somebody's list. A suspended account cannot do it, and neither can
        // somebody the recipient has blocked — blocking is meant to stop them
        // reaching you, and this is reaching you.
        //
        // And the limit that was missing: *what* may be written. The screen
        // files a notification by its `type`, and a `type` of 'moderation'
        // lands under "Safety" looking exactly like a decision SmartSync made.
        // Nothing here checked the field, so any account could write "Your
        // account has been closed — email us to appeal" into anybody's inbox,
        // pointing at whatever listing it liked. Now a notification about an
        // activity has to come from somebody on that activity's roster, and a
        // moderation notice has to come from an admin. Nothing else exists.
        //
        // `kind` and `params` are what the record was worded from — the
        // template and its fill-ins — so a newer app, and the push that
        // reaches a closed one, can word it in the reader's language without
        // parsing the English. Both optional; a bounded map of strings. The
        // `delivery` field is not in the list on purpose: it is written only
        // by the Cloud Function (which bypasses these rules) to say what was
        // sent, and a client must not be able to claim a push it never got.
        function notificationShape(n) {
          return n.keys().hasOnly(['type', 'title', 'body', 'activityId', 'read', 'createdAt', 'kind', 'params'])
            && n.type is string
            && isString(n.title, 120)
            && n.body is string
            && n.body.size() <= 300
            && n.read == false
            && (!('kind' in n) || isString(n.kind, 40))
            && (!('params' in n) || (n.params is map && n.params.size() <= 8));
        }

        // "Bob joined", "the host cancelled", "Bob wrote" — every one of those
        // is written by somebody on the roster of the activity it names.
        // Requiring that is also what stops a notification being used to send
        // somebody to a listing the sender has nothing to do with.
        function senderOnRoster(n) {
          return n.activityId is string
            && exists(/databases/$(database)/documents/activities/$(n.activityId))
            && request.auth.uid in
                 get(/databases/$(database)/documents/activities/$(n.activityId))
                   .data.participantUids;
        }

        allow create: if signedIn()
          && !cannotAct()
          && !hasBlocked(uid, request.auth.uid)
          && notificationShape(request.resource.data)
          && get(/databases/$(database)/documents/users/$(uid))
               .data.notificationsEnabled == true
          && (
            (
              request.resource.data.type in ['activity', 'chat', 'follow']
              && senderOnRoster(request.resource.data)
            ) || (
              request.resource.data.type == 'moderation'
              && isAdmin()
            )
          );
        allow update: if isSelf(uid) && touches(['read']);
        allow delete: if isSelf(uid);
      }

      match /following/{targetId} {
        allow read, write: if isSelf(uid);
      }

      // The devices that receive this person's browser pushes: one document
      // per FCM token, named by the token's hash so the token itself never
      // appears in a path. Written and read by the owner only; the Cloud
      // Function that sends reads them with the Admin SDK, past these
      // rules. Nobody else can learn how many devices somebody has, let
      // alone address them. The token is bounded, not validated — FCM says
      // whether it is real, and the Function deletes the ones that are not.
      match /pushTokens/{tokenId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly([
               'token', 'createdAt', 'lastSeenAt', 'label', 'language', 'timeZone',
               'platform', 'failures', 'lastError'
             ])
          && isString(request.resource.data.token, 4096)
          && request.resource.data.token.size() > 0
          && request.resource.data.lastSeenAt is timestamp
          && (!('label' in request.resource.data) || isString(request.resource.data.label, 80))
          && (!('language' in request.resource.data) || isString(request.resource.data.language, 12))
          && (!('timeZone' in request.resource.data) || isString(request.resource.data.timeZone, 64))
          && (!('platform' in request.resource.data) || isString(request.resource.data.platform, 20));
      }

      // The other half of a follow: who is listening to this person. Written
      // by the follower, about themselves, and readable by the host — that is
      // what lets the host's own client tell followers when it posts
      // something, which is the promise the Follow button makes. A list of
      // ids and a timestamp; nothing else may be written, nothing may be
      // edited, and nobody but the host and the follower can see a row.
      match /followers/{followerId} {
        allow read: if isSelf(uid) || isSelf(followerId);
        allow create: if isSelf(followerId)
          && followerId != uid
          && !isBanned()
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow update: if false;
        allow delete: if isSelf(followerId);
      }

      // Who this user has blocked. Private to them: publishing it would tell
      // people they had been blocked, and by whom, which is its own kind of
      // harm. The rules above read it with exists(), which sees past read
      // permissions, so it is enforced without ever being exposed.
      match /blocked/{targetId} {
        allow read: if isSelf(uid);
        // You may only block somebody else, and never yourself — a self block
        // would quietly make your own activities invisible to you.
        allow create: if isSelf(uid)
          && targetId != uid
          && isString(request.resource.data.name, 60);
        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    // ------------------------------------------------------------- activities

    // The category vocabulary, mirrored from src/data/categories.js. Kept in
    // both places deliberately: the client copy drives the UI, and this copy
    // stops anything else being written at all. An arbitrary category string
    // reached a Leaflet marker's innerHTML, which made it an injection point,
    // so this is a security control and not merely tidiness.
    function isKnownCategory(value) {
      return value in [
        'Football', 'Basketball', 'Running', 'Gym', 'Study', 'Coffee',
        'Gaming', 'Hangouts', 'Cycling', 'Movies', 'Food', 'Events'
      ];
    }

    function validActivity(data) {
      return isString(data.title, 100)
        && validPictureVersion(data)
        && data.description is string && data.description.size() <= 1000
        && isKnownCategory(data.category)
        && isString(data.locationName, 120)
        // The coordinate has to be inside Thailand, not merely somewhere on
        // Earth. SmartSync operates in one country: the map clamps to it and
        // will not show anything outside it, so an activity pinned in the
        // Atlantic is not a far-away activity — it is an invisible one, taking
        // up a slot in every query and reachable only by its direct link.
        // These four numbers are the same box as src/data/region.js; they are
        // repeated because the rules language cannot import, so if you move
        // one, move both.
        //
        // A rectangle around Thailand unavoidably includes slivers of its
        // neighbours. That is accepted: the job here is to reject the absurd,
        // and the client narrows it no further.
        && data.lat is number && data.lat >= 5.5 && data.lat <= 20.6
        && data.lng is number && data.lng >= 97.2 && data.lng <= 105.7
        && data.capacity is int && data.capacity >= 2 && data.capacity <= 500
        // Every query for activities filters on startsAt, so a document
        // without one is invisible to the app but still occupies the
        // collection. An integrity sweep found exactly that, written through
        // the REST API while the rules were not looking for it.
        && data.startsAt is timestamp
        // `date` and `time` are the wall clock at the venue; `startsAt` is the
        // instant, and only the instant is queried on. Both are kept on
        // purpose — an activity at 19:00 in Bangkok reads as 19:00 to a viewer
        // in London too, which deriving the display from the timestamp would
        // get wrong — but until now only one of the two was validated, so a
        // write through the API could leave a card showing anything at all.
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.timeBand is string
        && isTagList(data.tags, 10)
        && data.status in ['active', 'cancelled', 'removed']
        && data.participantUids is list
        && data.participantUids.size() <= data.capacity
        // A roster with the same uid twice would let one person consume every
        // seat, so duplicates are rejected outright.
        && data.participantUids.size() == data.participantUids.toSet().size();
    }

    function joinersAdded() {
      return request.resource.data.participantUids.toSet()
        .difference(resource.data.participantUids.toSet());
    }

    function joinersRemoved() {
      return resource.data.participantUids.toSet()
        .difference(request.resource.data.participantUids.toSet());
    }

    function rosterIsClean() {
      return request.resource.data.participantUids is list
        && request.resource.data.participantUids.size()
           == request.resource.data.participantUids.toSet().size();
    }

    // Exactly one person added, and it is the caller, and there is room.
    function joinsSelf() {
      return joinersAdded().hasOnly([request.auth.uid])
        && joinersAdded().size() == 1
        && joinersRemoved().size() == 0
        && request.resource.data.participantUids.size() <= resource.data.capacity
        && resource.data.status == 'active'
        && !cannotAct()
        // Nobody joins a suspended host. Somebody is suspended precisely
        // because they may be a danger to the people they would be meeting,
        // and without this their existing activities stayed live and kept
        // accepting strangers — the suspension protecting nobody from the
        // thing it was for. The client cannot enforce this on its own either:
        // roles are readable only by their owner and by an admin, so
        // discovery genuinely cannot tell, and this rule is the only place
        // the answer is known.
        && !accountSuspended(resource.data.hostId)
        // A host who blocked you does not have to host you. Enforced here
        // rather than by hiding the activity, because hiding is a client-side
        // courtesy and this is the part that has to actually hold.
        && !hasBlocked(resource.data.hostId, request.auth.uid);
    }

    // Exactly one person removed, and it is the caller. The host may not
    // leave their own activity — that would orphan it; they delete instead.
    function leavesSelf() {
      return joinersRemoved().hasOnly([request.auth.uid])
        && joinersRemoved().size() == 1
        && joinersAdded().size() == 0
        && request.auth.uid != resource.data.hostId;
    }

    // A host may remove any participant except themselves.
    function hostRemovesParticipant() {
      return resource.data.hostId == request.auth.uid
        && joinersAdded().size() == 0
        && joinersRemoved().size() == 1
        && !joinersRemoved().hasAny([resource.data.hostId]);
    }

    match /activities/{activityId} {
      // Discovery requires reading activities you have not joined.
      allow read: if signedIn() && !isBanned();

      allow create: if signedIn()
        && !cannotAct()
        && request.resource.data.hostId == request.auth.uid
        // A host starts as the sole participant of their own activity.
        && request.resource.data.participantUids == [request.auth.uid]
        // Something new is active. 'removed' is an admin's word, and a
        // host cannot pre-write the record of a decision nobody has taken.
        && request.resource.data.status == 'active'
        && !('moderation' in request.resource.data)
        && validActivity(request.resource.data);

      // Two disjoint kinds of update:
      //
      // 1. The host editing their own activity. May not touch the roster
      //    (membership is earned by joining, not granted by the host), may not
      //    hand the activity to someone else, and may not shrink capacity
      //    below the people already in.
      // 2. Anyone joining or leaving, or a host removing a participant. Only
      //    the roster and updatedAt may move, and the delta must be exactly
      //    the caller — which is checkable here precisely because it is a
      //    single field on a single document.
      allow update: if signedIn() && (
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.participantUids == resource.data.participantUids
          && request.resource.data.capacity >= resource.data.participantUids.size()
          // An admin's decision is not the host's to reverse. Once an
          // activity is removed it is frozen to its host: they cannot put it
          // back, cannot relabel it 'cancelled' to hide that it was taken
          // down, and cannot keep editing it. Nothing above said so, and
          // `validActivity` accepts every status, so until this line a host
          // could simply write status back to 'active'. A rule test found it.
          && resource.data.status != 'removed'
          && request.resource.data.status in ['active', 'cancelled']
          // Neither may a host forge a moderation record, or erase one.
          && !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['moderation'])
          && validActivity(request.resource.data)
        ) || (
          touches(['participantUids', 'updatedAt'])
          && rosterIsClean()
          && (joinsSelf() || leavesSelf() || hostRemovesParticipant())
        ) || (
          // The host's name and avatar are copied onto each activity, and
          // the copy has to follow the profile — on a removed activity too,
          // which the host may otherwise not touch. Anonymous mode that
          // stopped at removed activities would leave the real name on
          // exactly the listings an admin is looking at, and because the
          // profile and the activities are written together, one frozen
          // activity used to make the switch impossible to flip at all.
          // Nothing else may move: not the status, not the roster, not the
          // record of who took it down.
          resource.data.hostId == request.auth.uid
          && !isBanned()
          && touches(['hostName', 'hostAvatar', 'hostPictureVersion', 'updatedAt'])
          && isString(request.resource.data.hostName, 60)
          && request.resource.data.hostAvatar is string
          && (!('hostPictureVersion' in request.resource.data)
            || (request.resource.data.hostPictureVersion is string
              && request.resource.data.hostPictureVersion.matches('^[a-zA-Z0-9-]{1,64}$')))
        ) || (
          // Moderation. An admin may take an activity down and record why,
          // and may do nothing else to it — not edit its details, not touch
          // its roster, not hand it to somebody. Taking something down is a
          // narrow power on purpose.
          isAdmin()
          && touches(['status', 'moderation', 'updatedAt'])
          && request.resource.data.moderation.by == request.auth.uid
          && isString(request.resource.data.moderation.reason, 300)
          && request.resource.data.moderation.keys().hasOnly(['by', 'reason', 'reportId'])
          // A takedown made from the queue names its report, and then it
          // has to hold that report's claim — still open, still theirs — at
          // the moment it lands. A takedown made from the activity's own
          // page names none and is judged as before.
          && (
            !('reportId' in request.resource.data.moderation)
            || (
              exists(/databases/$(database)/documents/reports/$(request.resource.data.moderation.reportId))
              && get(/databases/$(database)/documents/reports/$(request.resource.data.moderation.reportId)).data.status == 'open'
              && get(/databases/$(database)/documents/reports/$(request.resource.data.moderation.reportId)).data.claim.by == request.auth.uid
            )
          )
          && (
            request.resource.data.status == 'removed'
            // Putting something back. A mistake has to be fixable — an
            // unrecoverable takedown is its own kind of harm — but never
            // silently: the restore overwrites `moderation` with who did it
            // and why, so the record shows both decisions in turn.
            || (
              resource.data.status == 'removed'
              && request.resource.data.status == 'active'
            )
          )
        )
      );

      // A host may delete an activity that never got going — one where they
      // are still the only person on the roster. There is nobody whose plans
      // it would erase and, in practice, no conversation to strand.
      //
      // Anything anyone else has joined must be cancelled instead. Deleting
      // it would leave the messages subcollection unreachable (deleting a
      // document does not delete what lives beneath it) and would take other
      // people's chat history with it. See ADR-004.
      //
      // Residual risk, stated rather than hidden: a host who posted messages
      // to their own empty activity and then deleted it orphans those
      // messages. That is a negligible amount of data and only ever their
      // own words.
      //
      // A removed activity cannot be deleted by its host at all, even an empty
      // one. Deleting it would erase the moderation record along with it,
      // which is exactly what someone who had just been moderated would want.
      allow delete: if signedIn()
        && resource.data.hostId == request.auth.uid
        && resource.data.participantUids == [request.auth.uid]
        && resource.data.status != 'removed';

      // ----------------------------------------------------------- messages

      match /messages/{messageId} {
        function activity() {
          return get(/databases/$(database)/documents/activities/$(activityId)).data;
        }

        function isParticipant() {
          return signedIn() && request.auth.uid in activity().participantUids;
        }

        // Activity chat is tied to the activity, and does not outlive it by
        // much: thirty days after it starts, the thread stops being readable
        // and writable by anybody.
        //
        // This is retention enforced by the database, not a filter in the
        // client — a distinction that matters, because a client-side filter
        // is decoration that anyone can step around by querying directly.
        //
        // It is expiry of *access*, not deletion. Actually removing the
        // documents needs a scheduled job, and scheduled jobs on Firebase
        // mean Cloud Functions, which mean the paid plan. Saying "the chat
        // is deleted" would therefore be a lie; saying "nobody can reach it
        // any more, and here is the rule that stops them" is true and
        // checkable. Two tests cover it.
        function withinRetention() {
          return activity().startsAt > request.time - duration.value(30, 'd');
        }

        allow read: if isParticipant() && withinRetention() && !isBanned();

        allow create: if isParticipant()
          && withinRetention()
          && !cannotAct()
          && request.resource.data.senderId == request.auth.uid
          && isString(request.resource.data.text, 2000);

        // Append-only: no silent edits, no deleting evidence.
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ roles
    match /roles/{uid} {
      // You can see your own role — the app needs it to decide whether to
      // show the admin console — and an admin can see everyone's, which
      // they need to do the job.
      allow read: if isSelf(uid) || isAdmin();

      // One rank acts, and nobody may edit their own row: a person who can
      // edit their own role can undo any limit placed on them, and an admin
      // who can strip their own admin is one mis-tap from locking everyone
      // out.
      //
      // An admin warns, suspends, closes and reopens anybody except another
      // admin. The only role the app may write is 'user' — there is no
      // rank to hand out, and admin stays a console-only act, so
      // compromising one account cannot make more. Acting on a fellow admin
      // is refused outright: two admins able to disable one another is a
      // race whose winner is whoever moves first.
      allow create, update: if isAdmin()
        && uid != request.auth.uid
        // Exactly these three fields and nothing else. A role document is the
        // most consequential row in the database, and everything reading it
        // looks at these — so anything else on it is state nobody validates,
        // nobody reads, and nobody would notice arriving.
        && request.resource.data.keys().hasOnly(['role', 'suspended', 'banned'])
        && request.resource.data.suspended is bool
        && (!('banned' in request.resource.data) || request.resource.data.banned is bool)
        && request.resource.data.role == 'user'
        && rankOf(uid) != 'admin';

      // Deleting the row is lifting every limit at once — no row means an
      // ordinary user in good standing. So it carries the same limit as
      // editing one: an admin may not erase a fellow admin. Without the rank
      // check, "an admin cannot suspend another admin" would be true and
      // useless, because they could delete them instead, which is strictly
      // worse.
      allow delete: if isAdmin()
        && uid != request.auth.uid
        && rankOf(uid) != 'admin';
    }

    // --------------------------------------------------------------- warnings
    //
    // The rung below a suspension. Somebody accumulating reports gets told, in
    // writing, what the problem is and that it has been noticed — before
    // anything is taken away from them. Most people stop there, and a system
    // whose only options are "nothing" and "you cannot use this any more"
    // reaches for the second far too often.
    //
    // A warning is a record, not a message: immutable and undeletable by
    // everybody including the admin who wrote it. The person warned can read
    // their own, which is the point — a warning nobody can review is a
    // rumour.
    match /warnings/{warningId} {
      allow read: if signedIn()
        && !isBanned()
        && (resource.data.subjectId == request.auth.uid || isAdmin());

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['subjectId', 'by', 'reason', 'reportId', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        // Nobody warns themselves, and nobody warns a fellow admin — the
        // same ladder as every other action.
        && request.resource.data.subjectId != request.auth.uid
        && rankOf(request.resource.data.subjectId) != 'admin'
        && isString(request.resource.data.reason, 500)
        // A warning issued from the queue names its report, and then it has
        // to hold that report's claim — still open, still theirs — and be
        // about the person the report is about. A warning issued from a
        // profile names none and is judged as before. Same shape as a
        // takedown that names its report (see /activities).
        && (
          !('reportId' in request.resource.data)
          || (
            isString(request.resource.data.reportId, 200)
            && exists(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
            && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.status == 'open'
            && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.claim.by == request.auth.uid
            && (
              !('subjectId' in get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data)
              || get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.subjectId == request.resource.data.subjectId
            )
          )
        );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- reports
    //
    // A reporter may file one and read back their own. An admin reads all of
    // them, because that is the queue. Nobody can edit the substance of a
    // report or delete one: reports are evidence, and evidence the accused can
    // alter or erase is not evidence.
    //
    // Residual risk, stated rather than hidden: an admin can read a report
    // filed about themselves, and so can learn who filed it. Firestore has no
    // field-level read rules and a query is refused wholesale if any document
    // in it fails, so excluding those from the queue is done in the client and
    // is a courtesy, not a control. What is enforced here is the part that
    // matters — they cannot act on it, in either direction.
    match /reports/{reportId} {
      allow read: if signedIn()
        && !isBanned()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      // A *suspended* account may still report, deliberately. Being under a
      // limit must not stop somebody flagging a danger to other people — that
      // would punish everybody else for the reporter's own conduct, and the
      // report costs nobody anything until an admin reads it.
      //
      // A *closed* account may not. They are out of the community, and the
      // queue is a scarce human resource: leaving it open to somebody who has
      // been removed is leaving a way to generate work and to aim it at
      // people. Found by filing one from a closed account and watching it
      // land in the queue.
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['user', 'activity', 'message']
        && isString(request.resource.data.targetId, 200)
        && isString(request.resource.data.subjectId, 200)
        && namesTheRightPerson(request.resource.data)
        && request.resource.data.reason in
             ['harassment', 'inappropriate', 'spam', 'fake', 'safety', 'other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1000
        && request.resource.data.status == 'open'
        // A report arrives unclaimed. A reporter who could file it already
        // held would be choosing its reviewer.
        && !('claim' in request.resource.data);

      // Working a report is two writes, in order: claim it, then act and
      // record in one transaction.
      //
      // The claim is the part that was missing. Two admins could act on
      // the same report at once; the record kept whichever landed second,
      // and the action — a suspension — was taken on a complaint a colleague
      // had already dismissed. A claim is a lease: one admin, stamped
      // with the server's clock, that nobody else may take while it is fresh.
      // Every action taken from the queue reads the claim in the same
      // transaction that writes the consequence, so a claim that was lost —
      // taken over after it went stale, or the report closed — aborts the
      // action before anything changes.
      //
      // Where the action itself can name its report — a takedown, a
      // warning — the claim is checked on that write too (see /activities
      // and /warnings). A role row cannot: it is three fields and nothing
      // else, on purpose. So the decision is committed in the same
      // transaction as the action, and the decision needs the claim (below):
      // a transaction lands whole or not at all, which makes a suspension
      // recorded against a report impossible to commit without holding its
      // claim, and leaves no moment at which the account is suspended and
      // the report still open. An admin suspending from the accounts list
      // names no report and is judged by /roles alone, as before.
      //
      // Stale after five minutes. An admin who closed the tab mid-action
      // must not lock a report for good; a colleague may take over then, and
      // the original's late writes are refused because the claim is no
      // longer theirs. Their own fresh claim may be renewed.
      function claimFresh(c) {
        return c.at is timestamp && c.at > request.time - duration.value(5, 'm');
      }
      function claimFree(data) {
        return !('claim' in data)
          || data.claim.by == request.auth.uid
          || !claimFresh(data.claim);
      }
      function claimIsMine(data) {
        return 'claim' in data && data.claim.by == request.auth.uid;
      }
      function validClaim(c) {
        return c.keys().hasOnly(['by', 'at'])
          && c.by == request.auth.uid
          // Stamped by the server, so the lease is measured on one clock.
          && c.at == request.time;
      }

      // The report itself stays immutable to everybody. An admin may
      // claim it, release their own claim, and record what they decided —
      // and nothing else. Letting a reviewer edit the reason or the
      // description would make the record worthless, and letting anyone
      // delete it would make it disappearable.
      allow update: if isAdmin()
        // Closed once. Two admins ruling on the same report within
        // seconds of each other both succeeded, and the record kept only
        // whichever landed second — "no action needed" over an account
        // that had just been suspended. The first decision is the decision;
        // the second is told so by the app.
        && resource.data.status == 'open'
        // Nobody works a report they are a party to — on either side.
        //
        // Being the subject is the obvious half: an admin could never
        // suspend themselves, that rule is in /roles, but without this they
        // could mark the complaint dismissed and bury it, which is the same
        // power exercised quietly. Their own activities and their own messages
        // count as themselves.
        //
        // Being the reporter is the half that is easy to forget. An admin
        // who reports somebody and then rules on it is prosecutor and judge,
        // and the record would show a decision that looks independent and is
        // not.
        && !aboutMe(resource.data)
        && resource.data.reporterId != request.auth.uid
        && (
          // Taking the claim, or renewing your own.
          (
            touches(['claim'])
            && 'claim' in request.resource.data
            && validClaim(request.resource.data.claim)
            && claimFree(resource.data)
          )
          // Releasing your own — an action that failed lets the next person in.
          || (
            touches(['claim'])
            && !('claim' in request.resource.data)
            && claimIsMine(resource.data)
          )
          // Recording the decision, which needs the claim.
          || (
            touches(['status', 'reviewedBy', 'reviewedAt', 'outcome'])
            && claimIsMine(resource.data)
            && request.resource.data.status in ['actioned', 'dismissed']
            && request.resource.data.reviewedBy == request.auth.uid
          )
        );

      allow delete: if false;
    }

    // --------------------------------------------------------- moderation log
    //
    // What an admin did, as a record the rules can vouch for. The state
    // documents say what is true now — a role row says suspended, an
    // activity says removed — and nothing said who made it so, when, or why:
    // a role row is three fields on purpose, and a restore overwrites the
    // takedown it undoes. This collection holds the decisions in order.
    //
    // Three things make an entry worth reading. It names its writer as the
    // caller and nobody else, so a record cannot be pinned on a colleague.
    // It is stamped by the server's clock. And it can only claim a state
    // the subject is actually in when the write lands: `getAfter` reads the
    // document as it will be once this batch commits, so an entry saying
    // "suspended" is refused unless the role row — written in the same
    // transaction, or already there — says so too. Nothing is ever edited
    // or deleted, by anybody.
    //
    // Stated rather than hidden: an entry is written by the client that
    // took the action, so somebody writing to Firestore directly could take
    // an action and skip the record. The state documents stay the truth;
    // this is the index of how they came to be that way, complete for
    // everything done through the app.
    match /moderationLog/{entryId} {
      function entry() {
        return request.resource.data;
      }
      function roleAfter() {
        return getAfter(/databases/$(database)/documents/roles/$(entry().subjectId)).data;
      }
      function activityAfter() {
        return getAfter(/databases/$(database)/documents/activities/$(entry().activityId)).data;
      }
      function statesMatch() {
        return (entry().kind == 'suspend' && roleAfter().suspended == true)
          || (entry().kind == 'lift' && roleAfter().suspended == false)
          || (entry().kind == 'close' && roleAfter().get('banned', false) == true)
          || (entry().kind == 'reopen' && roleAfter().get('banned', false) == false)
          || (
            entry().kind == 'remove'
            && activityAfter().status == 'removed'
            && activityAfter().hostId == entry().subjectId
          )
          || (
            entry().kind == 'restore'
            && activityAfter().status == 'active'
            && activityAfter().hostId == entry().subjectId
          );
      }

      allow read: if isAdmin();

      allow create: if isAdmin()
        && entry().keys().hasOnly(['kind', 'by', 'subjectId', 'activityId', 'reportId', 'reason', 'at'])
        && entry().kind in ['suspend', 'lift', 'close', 'reopen', 'remove', 'restore']
        && entry().by == request.auth.uid
        && entry().at == request.time
        && isString(entry().subjectId, 200)
        && entry().reason is string
        && entry().reason.size() <= 500
        && (!('reportId' in entry()) || isString(entry().reportId, 200))
        // The two kinds about an activity name it; the four about an account
        // do not.
        && ((entry().kind in ['remove', 'restore']) == ('activityId' in entry()))
        && (!('activityId' in entry()) || isString(entry().activityId, 200))
        && statesMatch();

      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
