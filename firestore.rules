rules_version = '2';

// =============================================================================
// SmartSync security rules
//
// Design principle: the client is untrusted. Every constraint the UI relies on
// (you can only join once, a full activity cannot be joined, only the host can
// edit, chat is for participants only) is enforced here too, because anyone
// can call Firestore directly without going through the UI.
//
// Privacy model: users/{uid} is the PUBLIC profile, readable by any signed-in
// user, because discovery and compatibility matching genuinely need it.
// Anything that must not be public — email, real name while anonymous mode is
// on, precise location — lives in users/{uid}/private/profile, readable only
// by its owner. Firestore has no field-level read rules, so separating the
// documents is the only way to make this real rather than cosmetic.
//
// Membership model: participants are a `participantUids` array on the activity
// document itself, NOT a subcollection. This is a correctness requirement, not
// a preference. Rules evaluate each write on its own against pre-write state
// and cannot see sibling writes in the same batch, so a design that kept the
// roster and a counter in two documents could not distinguish "incrementing
// because I joined" from "incrementing because I felt like it" — anyone could
// inflate an activity to full and lock others out. Holding the roster in one
// field makes each membership change atomically verifiable here.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function touches(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ------------------------------------------------------------------ roles
    //
    // Roles live in their own collection, never on the profile a user can
    // edit. That is the whole design: a role stored anywhere its holder can
    // write is a role its holder can grant themselves.
    //
    // `admin` can only ever be set from the Firebase console. There is no
    // in-app path to create one, so compromising a moderator — or an admin —
    // cannot mint more admins. Moderators are grantable in-app by an admin,
    // because that is routine work; admin is not.

    function roleDoc(uid) {
      return get(/databases/$(database)/documents/roles/$(uid)).data;
    }

    function hasRoleDoc() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() && hasRoleDoc() ? roleDoc(request.auth.uid).role : 'user';
    }

    // A suspended account holds its rank but exercises none of it. Otherwise
    // suspending a moderator who was abusing the queue would take nothing
    // away from them: they would keep removing activities and suspending
    // people while suspended themselves. The rank is kept rather than stripped
    // so that lifting the suspension restores what they were, and so the
    // record shows a suspended moderator rather than a demoted stranger.
    function isAdmin() {
      return myRole() == 'admin' && !cannotAct();
    }

    function isModerator() {
      return (myRole() == 'moderator' || myRole() == 'admin') && !cannotAct();
    }

    // Would the row this write produces mark the account closed? On a merge
    // `request.resource.data` is the document as it will be, so this catches
    // both setting the flag and leaving an existing one in place.
    function willBeBanned() {
      return 'banned' in request.resource.data && request.resource.data.banned == true;
    }

    // The rank of the person being acted ON, as opposed to myRole(), which is
    // the rank of whoever is calling. Somebody with no row is an ordinary user.
    function rankOf(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        ? roleDoc(uid).role : 'user';
    }

    // Suspension is a state, not a role: it can sit on anybody. A suspended
    // account can still read — being told why you cannot post is the point —
    // but cannot create, join, or say anything.
    //
    // Written to take a uid rather than always meaning "me", because the
    // sharpest question suspension raises is about somebody else: is the host
    // of the activity I am about to join suspended?
    function accountSuspended(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        && get(/databases/$(database)/documents/roles/$(uid)).data.suspended == true;
    }

    // A closed account. Strictly more than a suspension: a suspended person
    // can still read SmartSync and is told why, because the point is that
    // they can see the limit and appeal it. A closed account is the end of
    // the relationship — nothing is readable and nothing is writable.
    //
    // `get(...).data.get('banned', false)` rather than `.banned`, because
    // every role row written before this existed has only two fields and
    // reading a missing key would error the rule into refusing everybody.
    function accountBanned(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        && get(/databases/$(database)/documents/roles/$(uid)).data.get('banned', false) == true;
    }

    function isSuspended() {
      return signedIn() && accountSuspended(request.auth.uid);
    }

    function isBanned() {
      return signedIn() && accountBanned(request.auth.uid);
    }

    // Everything a suspension refuses, a closed account refuses too. Written
    // as one helper so a new write path cannot accidentally check only one of
    // the two — which is exactly the kind of gap that hides in a system with
    // more than one kind of restriction.
    function cannotAct() {
      return isSuspended() || isBanned();
    }

    // Has `ownerId` blocked `otherId`? Their block list is private, but rules
    // read through that — which is the point: blocking has to be enforceable
    // by the server without publishing who blocked whom.
    function hasBlocked(ownerId, otherId) {
      return exists(/databases/$(database)/documents/users/$(ownerId)/blocked/$(otherId));
    }

    // Is this report about the caller?
    //
    // `subjectId` is the person answerable for whatever was reported — the
    // person themselves, the host of the activity, or the sender of the
    // message. It is verified against reality when the report is created (see
    // namesTheRightPerson), so it can be trusted here and by the queue, which
    // suspends `subjectId` and not `targetId`. Reporting a message used to
    // suspend the message: `targetId` is a message id, and a roles document
    // was being written against it.
    //
    // The two fallbacks keep reports filed before `subjectId` existed
    // reviewable, rather than freezing them into the queue forever.
    function aboutMe(report) {
      return ('subjectId' in report && report.subjectId == request.auth.uid)
        || report.targetId == request.auth.uid
        || (
          report.targetType == 'activity'
          && exists(/databases/$(database)/documents/activities/$(report.targetId))
          && get(/databases/$(database)/documents/activities/$(report.targetId))
               .data.hostId == request.auth.uid
        );
    }

    // Does the report point at the person actually responsible for the thing
    // being reported? Checked at creation, because `subjectId` decides who
    // gets suspended: without this a reporter could quote one person's
    // message and name somebody else as its sender.
    function namesTheRightPerson(r) {
      return (r.targetType == 'user' && r.subjectId == r.targetId)
        || (
          r.targetType == 'activity'
          && exists(/databases/$(database)/documents/activities/$(r.targetId))
          && get(/databases/$(database)/documents/activities/$(r.targetId)).data.hostId
               == r.subjectId
        )
        || (
          r.targetType == 'message'
          && exists(/databases/$(database)/documents/activities/$(r.activityId)/messages/$(r.targetId))
          && get(/databases/$(database)/documents/activities/$(r.activityId)/messages/$(r.targetId))
               .data.senderId == r.subjectId
        );
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isTagList(value, maxItems) {
      return value is list && value.size() <= maxItems;
    }

    // ------------------------------------------------------------------ users

    function validPublicProfile(data) {
      return isString(data.name, 60)
        && isString(data.username, 40)
        && data.bio is string && data.bio.size() <= 300
        && isTagList(data.interests, 20)
        && isTagList(data.historyCategories, 40)
        && data.preferredTime is string
        && data.anonymous is bool
        && data.notificationsEnabled is bool
        && data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // Public profile: readable by any signed-in user. This is what powers
      // peer discovery, participant lists and compatibility scoring.
      //
      // A closed account keeps only itself. It has to be able to load its own
      // profile or the app cannot boot far enough to tell it what happened —
      // a blank error screen is not an explanation.
      allow read: if signedIn() && (isSelf(uid) || !isBanned());

      // A closed account cannot rewrite the profile other people see. It is
      // the one write left that changes how somebody is recognised, and the
      // point of closing an account is that the relationship has ended.
      //
      // A *suspended* account keeps all of this on purpose. They are still a
      // member with a limit on them, and anonymous mode is a protection —
      // taking someone's privacy controls away as a punishment is a
      // punishment in the wrong direction.
      allow create: if isSelf(uid) && !isBanned() && validPublicProfile(request.resource.data);

      allow update: if isSelf(uid)
        && !isBanned()
        && validPublicProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isSelf(uid) && !isBanned();

      // Private half of the profile. Never readable by anyone else.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        // Anyone signed in may notify a user ("Bob joined your activity" has
        // to be written by Bob), but only with a well-formed unread message,
        // so a sender cannot forge a pre-read system notification.
        //
        // The recipient's own preference is enforced here rather than left to
        // the sending client. That is the whole reason `notificationsEnabled`
        // sits on the public profile: a setting only its owner can read is a
        // setting nobody else can honour.
        //
        // Two limits that are easy to miss, because notifications are the one
        // collection anybody may write to. That makes them the way around
        // every other rule: no activity, no message, just a direct write into
        // somebody's list. A suspended account cannot do it, and neither can
        // somebody the recipient has blocked — blocking is meant to stop them
        // reaching you, and this is reaching you.
        allow create: if signedIn()
          && !cannotAct()
          && !hasBlocked(uid, request.auth.uid)
          && isString(request.resource.data.title, 120)
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 300
          && request.resource.data.read == false
          && get(/databases/$(database)/documents/users/$(uid))
               .data.notificationsEnabled == true;
        allow update: if isSelf(uid) && touches(['read']);
        allow delete: if isSelf(uid);
      }

      match /following/{targetId} {
        allow read, write: if isSelf(uid);
      }

      // Who this user has blocked. Private to them: publishing it would tell
      // people they had been blocked, and by whom, which is its own kind of
      // harm. The rules above read it with exists(), which sees past read
      // permissions, so it is enforced without ever being exposed.
      match /blocked/{targetId} {
        allow read: if isSelf(uid);
        // You may only block somebody else, and never yourself — a self block
        // would quietly make your own activities invisible to you.
        allow create: if isSelf(uid)
          && targetId != uid
          && isString(request.resource.data.name, 60);
        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    // ------------------------------------------------------------- activities

    // The category vocabulary, mirrored from src/data/categories.js. Kept in
    // both places deliberately: the client copy drives the UI, and this copy
    // stops anything else being written at all. An arbitrary category string
    // reached a Leaflet marker's innerHTML, which made it an injection point,
    // so this is a security control and not merely tidiness.
    function isKnownCategory(value) {
      return value in [
        'Football', 'Basketball', 'Running', 'Gym', 'Study', 'Coffee',
        'Gaming', 'Hangouts', 'Cycling', 'Movies', 'Food', 'Events'
      ];
    }

    function validActivity(data) {
      return isString(data.title, 100)
        && data.description is string && data.description.size() <= 1000
        && isKnownCategory(data.category)
        && isString(data.locationName, 120)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.capacity is int && data.capacity >= 2 && data.capacity <= 500
        // Every query for activities filters on startsAt, so a document
        // without one is invisible to the app but still occupies the
        // collection. An integrity sweep found exactly that, written through
        // the REST API while the rules were not looking for it.
        && data.startsAt is timestamp
        // `date` and `time` are the wall clock at the venue; `startsAt` is the
        // instant, and only the instant is queried on. Both are kept on
        // purpose — an activity at 19:00 in Bangkok reads as 19:00 to a viewer
        // in London too, which deriving the display from the timestamp would
        // get wrong — but until now only one of the two was validated, so a
        // write through the API could leave a card showing anything at all.
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.timeBand is string
        && isTagList(data.tags, 10)
        && data.status in ['active', 'cancelled', 'removed']
        && data.participantUids is list
        && data.participantUids.size() <= data.capacity
        // A roster with the same uid twice would let one person consume every
        // seat, so duplicates are rejected outright.
        && data.participantUids.size() == data.participantUids.toSet().size();
    }

    function joinersAdded() {
      return request.resource.data.participantUids.toSet()
        .difference(resource.data.participantUids.toSet());
    }

    function joinersRemoved() {
      return resource.data.participantUids.toSet()
        .difference(request.resource.data.participantUids.toSet());
    }

    function rosterIsClean() {
      return request.resource.data.participantUids is list
        && request.resource.data.participantUids.size()
           == request.resource.data.participantUids.toSet().size();
    }

    // Exactly one person added, and it is the caller, and there is room.
    function joinsSelf() {
      return joinersAdded().hasOnly([request.auth.uid])
        && joinersAdded().size() == 1
        && joinersRemoved().size() == 0
        && request.resource.data.participantUids.size() <= resource.data.capacity
        && resource.data.status == 'active'
        && !cannotAct()
        // Nobody joins a suspended host. Somebody is suspended precisely
        // because they may be a danger to the people they would be meeting,
        // and without this their existing activities stayed live and kept
        // accepting strangers — the suspension protecting nobody from the
        // thing it was for. The client cannot enforce this on its own either:
        // roles are readable only by their owner and by moderators, so
        // discovery genuinely cannot tell, and this rule is the only place
        // the answer is known.
        && !accountSuspended(resource.data.hostId)
        // A host who blocked you does not have to host you. Enforced here
        // rather than by hiding the activity, because hiding is a client-side
        // courtesy and this is the part that has to actually hold.
        && !hasBlocked(resource.data.hostId, request.auth.uid);
    }

    // Exactly one person removed, and it is the caller. The host may not
    // leave their own activity — that would orphan it; they delete instead.
    function leavesSelf() {
      return joinersRemoved().hasOnly([request.auth.uid])
        && joinersRemoved().size() == 1
        && joinersAdded().size() == 0
        && request.auth.uid != resource.data.hostId;
    }

    // A host may remove any participant except themselves.
    function hostRemovesParticipant() {
      return resource.data.hostId == request.auth.uid
        && joinersAdded().size() == 0
        && joinersRemoved().size() == 1
        && !joinersRemoved().hasAny([resource.data.hostId]);
    }

    match /activities/{activityId} {
      // Discovery requires reading activities you have not joined.
      allow read: if signedIn() && !isBanned();

      allow create: if signedIn()
        && !cannotAct()
        && request.resource.data.hostId == request.auth.uid
        // A host starts as the sole participant of their own activity.
        && request.resource.data.participantUids == [request.auth.uid]
        // Something new is active. 'removed' is a moderator's word, and a
        // host cannot pre-write the record of a decision nobody has taken.
        && request.resource.data.status == 'active'
        && !('moderation' in request.resource.data)
        && validActivity(request.resource.data);

      // Two disjoint kinds of update:
      //
      // 1. The host editing their own activity. May not touch the roster
      //    (membership is earned by joining, not granted by the host), may not
      //    hand the activity to someone else, and may not shrink capacity
      //    below the people already in.
      // 2. Anyone joining or leaving, or a host removing a participant. Only
      //    the roster and updatedAt may move, and the delta must be exactly
      //    the caller — which is checkable here precisely because it is a
      //    single field on a single document.
      allow update: if signedIn() && (
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.participantUids == resource.data.participantUids
          && request.resource.data.capacity >= resource.data.participantUids.size()
          // A moderator's decision is not the host's to reverse. Once an
          // activity is removed it is frozen to its host: they cannot put it
          // back, cannot relabel it 'cancelled' to hide that it was taken
          // down, and cannot keep editing it. Nothing above said so, and
          // `validActivity` accepts every status, so until this line a host
          // could simply write status back to 'active'. A rule test found it.
          && resource.data.status != 'removed'
          && request.resource.data.status in ['active', 'cancelled']
          // Neither may a host forge a moderation record, or erase one.
          && !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['moderation'])
          && validActivity(request.resource.data)
        ) || (
          touches(['participantUids', 'updatedAt'])
          && rosterIsClean()
          && (joinsSelf() || leavesSelf() || hostRemovesParticipant())
        ) || (
          // Moderation. A moderator may take an activity down and record why,
          // and may do nothing else to it — not edit its details, not touch
          // its roster, not hand it to somebody. Taking something down is a
          // narrow power on purpose.
          isModerator()
          && touches(['status', 'moderation', 'updatedAt'])
          && request.resource.data.moderation.by == request.auth.uid
          && isString(request.resource.data.moderation.reason, 300)
          && (
            request.resource.data.status == 'removed'
            // Putting something back is an admin's power, never a plain
            // moderator's. A mistake has to be fixable — an unrecoverable
            // takedown is its own kind of harm — but not by the same rank
            // that might have made it, and never silently: the restore
            // overwrites `moderation` with who did it and why, so the
            // record shows both decisions in turn.
            || (
              isAdmin()
              && resource.data.status == 'removed'
              && request.resource.data.status == 'active'
            )
          )
        )
      );

      // A host may delete an activity that never got going — one where they
      // are still the only person on the roster. There is nobody whose plans
      // it would erase and, in practice, no conversation to strand.
      //
      // Anything anyone else has joined must be cancelled instead. Deleting
      // it would leave the messages subcollection unreachable (deleting a
      // document does not delete what lives beneath it) and would take other
      // people's chat history with it. See ADR-004.
      //
      // Residual risk, stated rather than hidden: a host who posted messages
      // to their own empty activity and then deleted it orphans those
      // messages. That is a negligible amount of data and only ever their
      // own words.
      //
      // A removed activity cannot be deleted by its host at all, even an empty
      // one. Deleting it would erase the moderation record along with it,
      // which is exactly what someone who had just been moderated would want.
      allow delete: if signedIn()
        && resource.data.hostId == request.auth.uid
        && resource.data.participantUids == [request.auth.uid]
        && resource.data.status != 'removed';

      // ----------------------------------------------------------- messages

      match /messages/{messageId} {
        function activity() {
          return get(/databases/$(database)/documents/activities/$(activityId)).data;
        }

        function isParticipant() {
          return signedIn() && request.auth.uid in activity().participantUids;
        }

        // Activity chat is tied to the activity, and does not outlive it by
        // much: thirty days after it starts, the thread stops being readable
        // and writable by anybody.
        //
        // This is retention enforced by the database, not a filter in the
        // client — a distinction that matters, because a client-side filter
        // is decoration that anyone can step around by querying directly.
        //
        // It is expiry of *access*, not deletion. Actually removing the
        // documents needs a scheduled job, and scheduled jobs on Firebase
        // mean Cloud Functions, which mean the paid plan. Saying "the chat
        // is deleted" would therefore be a lie; saying "nobody can reach it
        // any more, and here is the rule that stops them" is true and
        // checkable. Two tests cover it.
        function withinRetention() {
          return activity().startsAt > request.time - duration.value(30, 'd');
        }

        allow read: if isParticipant() && withinRetention() && !isBanned();

        allow create: if isParticipant()
          && withinRetention()
          && !cannotAct()
          && request.resource.data.senderId == request.auth.uid
          && isString(request.resource.data.text, 2000);

        // Append-only: no silent edits, no deleting evidence.
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ roles
    match /roles/{uid} {
      // You can see your own role — the app needs it to decide whether to
      // show the moderation screens — and moderators can see everyone's,
      // which they need to do the job.
      allow read: if isSelf(uid) || isModerator();

      // Two ranks with different reach, and nobody may edit their own row: a
      // person who can edit their own role can undo any limit placed on them,
      // and an admin who can strip their own admin is one mis-tap from
      // locking everyone out.
      //
      // An admin appoints and dismisses moderators, and suspends anybody
      // except another admin. They still cannot mint an admin — that stays a
      // console-only act, so compromising one account cannot make more.
      //
      // A moderator may suspend and restore ordinary users and nothing else.
      // Suspension is the sharpest tool they have and the whole reason the
      // rank exists: a moderator who could only take down one activity while
      // the same account posted ten more would not be moderating anything.
      // They cannot change anyone's role, and cannot touch a peer or a
      // superior — acting on a fellow moderator is an admin's call.
      allow create, update: if signedIn()
        && uid != request.auth.uid
        // Exactly these three fields and nothing else. A role document is the
        // most consequential row in the database, and everything reading it
        // looks at these — so anything else on it is state nobody validates,
        // nobody reads, and nobody would notice arriving.
        && request.resource.data.keys().hasOnly(['role', 'suspended', 'banned'])
        && request.resource.data.suspended is bool
        && (!('banned' in request.resource.data) || request.resource.data.banned is bool)
        && (
          (
            isAdmin()
            && request.resource.data.role in ['user', 'moderator']
            && rankOf(uid) != 'admin'
          ) || (
            isModerator()
            // Closing an account, and reopening one, is an admin's decision
            // and only an admin's: it is the one action with nothing after it.
            //
            // Two checks, not one. `willBeBanned()` stops them writing a row
            // that says closed. `accountBanned(uid)` stops them touching an
            // account that already is — and that second one is not redundant:
            // a plain `setDoc` replaces the document rather than merging, so
            // without it a moderator could reopen a closed account simply by
            // writing a fresh row with no `banned` key at all. A test caught
            // exactly that.
            && !willBeBanned()
            && !accountBanned(uid)
            && request.resource.data.role == 'user'
            && rankOf(uid) == 'user'
          )
        );

      // Deleting the row is demotion by another name — no row means an
      // ordinary user. So it carries the same limit as editing one: an admin
      // may dismiss a moderator this way, and may not erase a fellow admin.
      // Without the rank check, "an admin cannot suspend another admin" would
      // be true and useless, because they could delete them instead, which is
      // strictly worse.
      allow delete: if isAdmin()
        && uid != request.auth.uid
        && rankOf(uid) != 'admin';
    }

    // --------------------------------------------------------------- warnings
    //
    // The rung below a suspension. Somebody accumulating reports gets told, in
    // writing, what the problem is and that it has been noticed — before
    // anything is taken away from them. Most people stop there, and a system
    // whose only options are "nothing" and "you cannot use this any more"
    // reaches for the second far too often.
    //
    // A warning is a record, not a message: immutable and undeletable by
    // everybody including the moderator who wrote it and an admin. The person
    // warned can read their own, which is the point — a warning nobody can
    // review is a rumour.
    match /warnings/{warningId} {
      allow read: if signedIn()
        && !isBanned()
        && (resource.data.subjectId == request.auth.uid || isModerator());

      allow create: if isModerator()
        && request.resource.data.keys().hasOnly(
             ['subjectId', 'by', 'reason', 'reportId', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        // Nobody warns themselves, and nobody warns a peer or a superior —
        // the same ladder as every other action.
        && request.resource.data.subjectId != request.auth.uid
        && (isAdmin() || rankOf(request.resource.data.subjectId) == 'user')
        && isString(request.resource.data.reason, 500);

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- reports
    //
    // A reporter may file one and read back their own. Moderators read all of
    // them, because that is the queue. Nobody can edit the substance of a
    // report or delete one: reports are evidence, and evidence the accused can
    // alter or erase is not evidence.
    //
    // Residual risk, stated rather than hidden: a moderator can read a report
    // filed about themselves, and so can learn who filed it. Firestore has no
    // field-level read rules and a query is refused wholesale if any document
    // in it fails, so excluding those from the queue is done in the client and
    // is a courtesy, not a control. What is enforced here is the part that
    // matters — they cannot act on it, in either direction.
    match /reports/{reportId} {
      allow read: if signedIn()
        && !isBanned()
        && (resource.data.reporterId == request.auth.uid || isModerator());
      // A *suspended* account may still report, deliberately. Being under a
      // limit must not stop somebody flagging a danger to other people — that
      // would punish everybody else for the reporter's own conduct, and the
      // report costs nobody anything until a moderator reads it.
      //
      // A *closed* account may not. They are out of the community, and the
      // queue is a scarce human resource: leaving it open to somebody who has
      // been removed is leaving a way to generate work and to aim it at
      // people. Found by filing one from a closed account and watching it
      // land in the queue.
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['user', 'activity', 'message']
        && isString(request.resource.data.targetId, 200)
        && isString(request.resource.data.subjectId, 200)
        && namesTheRightPerson(request.resource.data)
        && request.resource.data.reason in
             ['harassment', 'inappropriate', 'spam', 'fake', 'safety', 'other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1000
        && request.resource.data.status == 'open';
      // The report itself stays immutable to everybody. A moderator may
      // record what they decided — and nothing else. Letting a reviewer edit
      // the reason or the description would make the record worthless, and
      // letting anyone delete it would make it disappearable.
      allow update: if isModerator()
        && touches(['status', 'reviewedBy', 'reviewedAt', 'outcome'])
        && request.resource.data.status in ['open', 'actioned', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        // Nobody closes a report they are a party to — on either side.
        //
        // Being the subject is the obvious half: a moderator could never
        // suspend themselves, that rule is in /roles, but without this they
        // could mark the complaint dismissed and bury it, which is the same
        // power exercised quietly. Their own activities and their own messages
        // count as themselves.
        //
        // Being the reporter is the half that is easy to forget. A moderator
        // who reports somebody and then rules on it is prosecutor and judge,
        // and the record would show a decision that looks independent and is
        // not.
        && !aboutMe(resource.data)
        && resource.data.reporterId != request.auth.uid;

      allow delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
